<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template
        id="portal_breadcrumbs"
        name="Portal layout: ticket and fsm order menu entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="55"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'fsm_order' or fsm_order"
                t-attf-class="breadcrumb-item #{'active ' if not fsm_order else ''}"
            >
                <a
                    t-if="fsm_order"
                    t-attf-href="/my/fsm_orders?{{ keep_query() }}"
                >Work Orders</a>
                <t t-else="">Work Orders</t>
            </li>
            <li t-if="fsm_order" class="breadcrumb-item active">
                <t t-out="fsm_order.name" />
            </li>
        </xpath>
    </template>

    <!--
        The portal home card used to be added here, by inheriting
        portal.portal_my_home. In saas-19.4 a card is a portal.entry RECORD
        instead — see data/portal_entry_data.xml. Adding it from a template
        does not merely fail to work: portal.portal_docs_entry now reads an
        `entry` record, so the call rendered the previous card a second time.
    -->
</odoo>
