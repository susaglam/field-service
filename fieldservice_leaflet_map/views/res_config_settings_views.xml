<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_fsm_map" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fsm.map</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="45" />
        <field name="inherit_id" ref="fieldservice.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='fieldservice']" position="inside">
                <block title="Map Settings" name="fsm_map_settings_container">
                    <setting
                        string="Default Map Zoom"
                        help="Initial zoom level (1=world, 18=street level). 7 is a good country-scale default."
                    >
                        <field name="fsm_map_default_zoom" />
                    </setting>
                    <setting
                        string="Default Map Latitude"
                        help="Map center latitude when the map opens empty (NL default ~52.1)."
                    >
                        <field name="fsm_map_default_latitude" />
                    </setting>
                    <setting
                        string="Default Map Longitude"
                        help="Map center longitude when the map opens empty (NL default ~5.3)."
                    >
                        <field name="fsm_map_default_longitude" />
                    </setting>
                    <setting
                        string="Auto-fit Map to Locations"
                        help="When checked, the map auto-zooms to encompass all visible locations on load."
                    >
                        <field name="fsm_map_fit_bounds" />
                    </setting>
                    <setting
                        string="Auto-Geocode New Locations"
                        help="Automatically run OpenStreetMap geocoding (Nominatim) on every Field Service location after create or address change. Without this you must run 'Geocode All Locations' manually to populate latitude/longitude."
                    >
                        <field name="fsm_map_auto_geocode" />
                    </setting>
                    <setting
                        string="Geocode All Locations Now"
                        help="Run OpenStreetMap geocoding on every existing Field Service location that does not yet have latitude/longitude set. Useful after enabling the map for the first time."
                    >
                        <button
                            name="action_fsm_geocode_all_locations"
                            type="object"
                            string="Run Geocoding"
                            class="btn-primary"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
