msgstr "Nieuwe locaties automatisch geocoderen"

#. module: fieldservice_leaflet_map
#: model:ir.model.fields,field_description:fieldservice_leaflet_map.field_res_company__fsm_map_fit_bounds
#: model:ir.model.fields,field_description:fieldservice_leaflet_map.field_res_config_settings__fsm_map_fit_bounds
#: model_terms:ir.ui.view,arch_db:fieldservice_leaflet_map.res_config_settings_view_form_fsm_map
