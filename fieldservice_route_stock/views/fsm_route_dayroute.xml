<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="fsm_route_dayroute_inventory" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.stock.form</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="inherit_id" ref="fieldservice_route.fsm_route_dayroute_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Capacity" name="capacity">
                    <group>
                        <group>
                            <field name="fsm_vehicle_id" />
                            <field name="is_limited" invisible="1" />
                            <field name="max_product_id" readonly="1" />
                            <field
                                name="max_product_qty"
                                readonly="1"
                                invisible="not is_limited"
                            />
                        </group>
                        <group>
                            <field name="product_qty" readonly="1" />
                            <field name="product_qty_remaining" readonly="1" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
