<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="fsm_vehicle_stock_form" model="ir.ui.view">
        <field name="name">fsm.vehicle.stock.form</field>
        <field name="model">fsm.vehicle</field>
        <field name="inherit_id" ref="fieldservice_vehicle.fsm_vehicle_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Stock &amp; Capacity" name="stock_capacity">
                    <group>
                        <field name="inventory_location_id" />
                    </group>
                    <group>
                        <field name="max_product_id" />
                        <field
                            name="max_product_qty"
                            invisible="not max_product_id"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
