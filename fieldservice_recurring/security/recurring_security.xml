<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- saas-19.4: ir.rule -> ir.access. Global (no group_id) multi-company
         rules become restrictions (AND'd for all). domain_force -> domain;
         no perm_* -> operation="crud". -->
    <record id="rule_fsm_frequency_multi_company" model="ir.access">
        <field name="name">FSM Frequency multi-company</field>
        <field name="model_id" ref="model_fsm_frequency" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fsm_recurring_template_multi_company" model="ir.access">
        <field name="name">FSM Recurring Template multi-company</field>
        <field name="model_id" ref="model_fsm_recurring_template" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fsm_recurring_multi_company" model="ir.access">
        <field name="name">FSM Recurring Order multi-company</field>
        <field name="model_id" ref="model_fsm_recurring" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
