#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_account_payment__id
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute__id
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__id
msgid "ID"
msgstr "Kimlik"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute__invoice_count
msgid "Invoice Count"
msgstr "Fatura Sayısı"

#. module: fieldservice_route_account
#: model_terms:ir.ui.view,arch_db:fieldservice_route_account.fsm_route_dayroute_inherit_dayroute
msgid "Invoices/Bills"
msgstr "Faturalar"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__journal_id
msgid "Journal"
msgstr "Yevmiye"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__move_id
msgid "Journal Entry"
msgstr "Yevmiye Fişi"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__write_uid
msgid "Last Updated by"
msgstr "Son Güncelleyen"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__write_date
msgid "Last Updated on"
msgstr "Son Güncelleme"

#. module: fieldservice_route_account
#: model:ir.model,name:fieldservice_route_account.model_account_payment
msgid "Payment"
msgstr "Ödeme"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute__dayroute_payment_ids
msgid "Payment Summary"
msgstr "Ödeme Özeti"

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute__dayroute_payment_ids
msgid ""
"Per-journal cash count for this day-route. Each row aggregates the payments "
"collected from this day-route's FSM orders."
msgstr ""
"Bu günlük güzergâh için yevmiye başına nakit sayımı. Her satır bu günlük "
"güzergâhın FSM siparişlerinden tahsil edilen ödemeleri birleştirir."

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__amount_collected
msgid ""
"Sum of payments that were posted against this day-route's FSM orders on the "
"selected journal. Auto-computed from account.payment records."
msgstr ""
"Seçilen yevmiyede bu günlük güzergâhın FSM siparişlerine işlenen ödemelerin "
"toplamı. account.payment kayıtlarından otomatik hesaplanır."

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__dayroute_id
msgid "The day-route whose order payments this row aggregates."
msgstr "Bu satırın sipariş ödemelerini topladığı günlük güzergâh."

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute__invoice_count
msgid ""
"Total number of customer invoices generated from the FSM orders on this day-"
"route."
msgstr ""
"Bu günlük güzergâhın FSM siparişlerinden oluşturulan müşteri faturalarının "
"toplam sayısı."
