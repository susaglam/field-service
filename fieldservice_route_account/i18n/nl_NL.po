#. module: fieldservice_route_account
#: model_terms:ir.ui.view,arch_db:fieldservice_route_account.fsm_route_dayroute_inherit_dayroute
msgid "Accounting"
msgstr "Boekhouding"

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__journal_id
msgid ""
"Accounting journal that received the payments for this day-route (Cash, "
"Bank, etc.). One row per journal — each row aggregates the collected vs. "
"counted amounts for that journal."
msgstr ""
"Boekhouddagboek waarop de betalingen voor deze dagroute geboekt zijn "
"(Kas, Bank, etc.). Eén rij per dagboek — elke rij telt de geïnde versus "
"de getelde bedragen voor dat dagboek op."

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__move_id
msgid ""
"Auto-generated account move that reconciles a positive difference into the "
"worker's receivable account when the day-route stage closes."
msgstr ""
"Automatisch gegenereerde boekingsregel die een positief verschil "
"verrekent met de vorderingsrekening van de medewerker wanneer de "
"dagroute-fase sluit."

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__amount_counted
msgid ""
"Cash / amount physically counted by the worker at the end of the day-route. "
"The difference between this and the Collected Amount becomes the day-route's"
" reconciliation discrepancy."
msgstr ""
"Contant geld / bedrag dat fysiek door de medewerker geteld wordt aan het "
"einde van de dagroute. Het verschil tussen dit en het Geïnde Bedrag is de "
"reconciliatie-discrepantie van de dagroute."

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__amount_collected
msgid "Collected Amount"
msgstr "Geïnd bedrag"

#. module: fieldservice_route_account
#: model:ir.model.fields,help:fieldservice_route_account.field_fsm_route_dayroute_payment__difference
msgid ""
"Collected Amount minus Counted Amount. Positive values indicate uncounted "
"cash (worker owes the company); negative values indicate over-counting "
"(company owes the worker)."
msgstr ""
"Geïnd bedrag minus geteld bedrag. Positieve waarden duiden op niet-geteld "
"contant geld (medewerker schuldig aan bedrijf); negatieve waarden duiden "
"op over-tellen (bedrijf schuldig aan medewerker)."

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__amount_counted
msgid "Counted Amount"
msgstr "Geteld bedrag"

#. module: fieldservice_route_account
#: model:ir.model.fields,field_description:fieldservice_route_account.field_fsm_route_dayroute_payment__create_uid
msgid "Created by"
msgstr "Aangemaakt door"

