<odoo>
    <!-- Menu Items -->
    <menuitem
        id="menu_fsm_product"
        name="Products"
        action="stock.product_template_action_product"
        parent="fieldservice.data"
        sequence="90"
    />
    <!-- The core action behind it requires stock.group_stock_user, so without
         this the menu was shown to every planner and fitter and raised
         "You don't have enough access rights to run this action" on click. -->
    <menuitem
        id="menu_fsm_stock_inventory"
        name="Inventory"
        action="stock.action_view_quants"
        parent="fieldservice.reporting"
        groups="stock.group_stock_user"
        sequence="30"
    />
</odoo>
