msgid ""
"Order %(order)s cannot be completed by you yet: completing it also books "
"transfer %(picking)s, and that needs Inventory rights. Ask a warehouse user "
"to complete the order, or ask an administrator to give you Inventory access."
msgstr ""

#. module: fieldservice_stock
#. odoo-python
#: code:addons/fieldservice_stock/models/fsm_order.py:0
msgid ""
"Order %(order)s cannot be completed yet: transfer %(picking)s asks for a "
"confirmation step before it can be validated. Open the transfer, validate it"
" there, then complete the order."
msgstr ""

#. module: fieldservice_stock
#. odoo-python
#: code:addons/fieldservice_stock/models/fsm_order.py:0
msgid ""
"Order %(order)s cannot be completed yet: transfer %(picking)s has "
"%(available)s of the %(demand)s %(uom)s of %(product)s it needs. Receive or "
"move the missing stock and complete the order again, or turn off 'Validate "
"Transfers on Order Completion' in Field Service settings to complete the "
"order and book the transfer by hand."
msgstr ""

